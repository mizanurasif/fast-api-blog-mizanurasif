# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Must use the async psycopg driver: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://bloguser:blogpass@localhost/blog

# ---------------------------------------------------------------------------
# Authentication (SECRET_KEY required)
# ---------------------------------------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# S3 storage for profile pictures (S3_BUCKET_NAME required)
# ---------------------------------------------------------------------------
S3_BUCKET_NAME=my-blog-media
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only for MinIO / LocalStack. Leave blank for real AWS.
# S3_ENDPOINT_URL=http://localhost:9000

# 5 MB
MAX_UPLOAD_SIZE_BYTES=5242880

# ---------------------------------------------------------------------------
# Email (password reset)
# ---------------------------------------------------------------------------
# Local dev: `uv run python -m aiosmtpd -n -l localhost:1025`
#   MAIL_SERVER=localhost / MAIL_PORT=1025 / MAIL_USE_TLS=false
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
POSTS_PER_PAGE=10

# Base URL used to build password-reset links in emails
FRONTEND_URL=http://localhost:8000
